def case_compare(request):
    case_a_id = request.GET.get("case_a")
    case_b_id = request.GET.get("case_b")
    query_text = request.GET.get("query", "")

    comparison = None
    error = None

    if case_a_id and case_b_id:
        if str(case_a_id) == str(case_b_id):
            alt_case = LegalCase.objects.exclude(id=case_a_id).first()
            if alt_case:
                case_b_id = str(alt_case.id)

        try:
            comparison = compare_cases(int(case_a_id), int(case_b_id), query_text=query_text)
        except Exception as e:
            logger.exception("Comparison error")
            error = f"Could not compare cases: {str(e)}"

    recent_cases = LegalCase.objects.all()[:50]

    return render(
        request,
        "cases/compare.html",
        {
            "comparison": comparison,
            "error": error,
            "case_a_id": case_a_id,
            "case_b_id": case_b_id,
            "recent_cases": recent_cases,
            "query_text": query_text,
        },
    )




